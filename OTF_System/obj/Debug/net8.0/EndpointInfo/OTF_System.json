          },
          "nic": {
            "maxLength": 12,
            "minLength": 0,
            "type": "string"
          },
          "policeStation": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string",
            "nullable": true
          },
          "phoneNumber": {
            "maxLength": 10,
            "minLength": 0,
            "type": "string"
          },
          "email": {
            "maxLength": 20,
            "minLength": 0,
            "type": "string",
            "nullable": true
          },
          "password": {
            "maxLength": 20,
            "minLength": 0,
            "type": "string"
          }
        },
