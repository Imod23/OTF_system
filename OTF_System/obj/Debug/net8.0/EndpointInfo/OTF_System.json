          "status"
        ],
        "type": "object",
        "properties": {
          "paymentID": {
            "type": "string",
            "nullable": true
          },
          "fineID": {
            "minLength": 1,
            "type": "string"
          },
          "expireDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "cvc": {
            "maxLength": 3,
            "minLength": 0,
            "type": "string",
            "nullable": true
          },
          "cardNumber": {
            "maxLength": 16,
            "minLength": 0,
            "type": "string",
            "nullable": true
          },
          "cardholderName": {
            "maxLength": 500,
            "minLength": 0,
            "type": "string"
          },
          "paymentDate": {
            "type": "string",
            "format": "date-time"
          },
          "paymentMethod": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "status": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string"
          },
          "receiptNumber": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "PoliceOfficer": {
        "required": [
          "fullName",
          "nic",
          "password",
          "phoneNumber"
        ],
        "type": "object",
        "properties": {
          "policeID": {
            "maxLength": 10,
            "minLength": 0,
            "type": "string",
            "nullable": true
          },
          "fullName": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string"
          },
          "username": {
            "maxLength": 500,
            "minLength": 0,
            "type": "string",
